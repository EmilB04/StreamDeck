{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Battery Monitor",
	"UUID": "com.emilberglund.batterymonitor",
	"Version": "1.0.0.0",
	"Author": "Emil Berglund",
	"Description": "Multi-purpose plugin. Starts with battery monitoring: scans the machine for wireless peripherals (headsets, Logitech HID++, Asus, Bluetooth) and shows the battery level of the one you pick.",
	"Icon": "imgs/plugin/marketplace",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Category": "Battery Monitor",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"Actions": [
		{
			"Name": "Device Battery",
			"UUID": "com.emilberglund.batterymonitor.battery-status",
			"Icon": "imgs/actions/battery-status/icon",
			"Tooltip": "Shows the battery level of a wireless device detected on this computer.",
			"PropertyInspectorPath": "ui/battery-status.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/battery-status/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			],
			"UserTitleEnabled": false
		},
		{
			"Name": "Lowest Battery",
			"UUID": "com.emilberglund.batterymonitor.lowest-battery",
			"Icon": "imgs/actions/lowest-battery/icon",
			"Tooltip": "Shows whichever detected device has the least charge left.",
			"PropertyInspectorPath": "ui/lowest-battery.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/lowest-battery/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			],
			"UserTitleEnabled": false
		}
	]
}

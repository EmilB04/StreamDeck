{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Battery Monitor",
	"UUID": "com.emilberglund.batterymonitor",
	"Version": "1.2.3.0",
	"Author": "Emil Berglund",
	"Description": "Shows the battery level of your wireless devices on a key. Finds your headsets, mice, keyboards, controllers and Bluetooth devices, warns you when one runs low, and can watch whichever device is emptiest.",
	"Icon": "imgs/plugin/marketplace",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Category": "Battery Monitor",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "disabled"
	},
	"Actions": [
		{
			"Name": "Device Battery",
			"UUID": "com.emilberglund.batterymonitor.battery-status",
			"Icon": "imgs/actions/battery-status/icon",
			"Tooltip": "Shows the battery level of a wireless device on this computer, with an optional backup device.",
			"PropertyInspectorPath": "ui/battery-status.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/battery-status/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			],
			"UserTitleEnabled": false
		},
		{
			"Name": "Lowest Battery",
			"UUID": "com.emilberglund.batterymonitor.lowest-battery",
			"Icon": "imgs/actions/lowest-battery/icon",
			"Tooltip": "Shows whichever detected device has the least charge left.",
			"PropertyInspectorPath": "ui/lowest-battery.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/lowest-battery/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			],
			"UserTitleEnabled": false
		},
		{
			"Name": "Device Renaming",
			"UUID": "com.emilberglund.batterymonitor.device-renaming",
			"Icon": "imgs/actions/device-renaming/icon",
			"Tooltip": "Rename detected devices for this plugin. Every key follows the new name.",
			"PropertyInspectorPath": "ui/device-renaming.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/device-renaming/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		}
	],
	"URL": "https://github.com/EmilB04/StreamDeck"
}
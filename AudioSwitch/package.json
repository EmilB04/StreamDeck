{
  "name": "com.emilberglund.audioswitch",
  "version": "1.0.0",
  "private": true,
  "description": "Stream Deck plugin that switches the Windows default playback and recording device from a key.",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.emilberglund.audioswitch\"",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "pack": "npm run build && streamdeck pack com.emilberglund.audioswitch.sdPlugin --output dist --force --no-update-check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Emil Berglund",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmilB04/StreamDeck.git"
  },
  "bugs": {
    "url": "https://github.com/EmilB04/StreamDeck/issues"
  },
  "homepage": "https://github.com/EmilB04/StreamDeck"
}
